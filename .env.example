# Vetra Studio runs locally without a cloud account. Copy this file to `.env`
# only when you are configuring your own hosted control plane.
#
# Never reuse another product's production identifiers: that would couple this
# fork to accounts, relay infrastructure, and OAuth callbacks it does not own.

# Optional: your Clerk application and OAuth client.
# VETRA_CLERK_PUBLISHABLE_KEY=pk_test_...
# VETRA_CLERK_JWT_TEMPLATE=vetra-relay
# VETRA_CLERK_CLI_OAUTH_CLIENT_ID=...

# Optional: your own relay and hosted app. Cloud/connect features stay disabled
# when these values are absent.
# VETRA_RELAY_URL=https://relay.example.com
# VETRA_HOSTED_APP_URL=https://studio.example.com

# Optional: desktop release infrastructure. Auto-update is opt-in and the build
# never falls back to the current GitHub repository automatically.
# VETRA_ENABLE_AUTO_UPDATE=true
# VETRA_DESKTOP_UPDATE_REPOSITORY=your-org/your-vetra-releases
# VITE_DESKTOP_RELEASE_TAG_URL=https://github.com/your-org/your-vetra-releases/releases/tag

# Optional: observability endpoints owned by your deployment.
# VETRA_OTLP_TRACES_URL=https://otel.example.com/v1/traces
# VETRA_OTLP_METRICS_URL=https://otel.example.com/v1/metrics
